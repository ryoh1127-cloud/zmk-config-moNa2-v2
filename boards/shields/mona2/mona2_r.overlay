#include "mona2.dtsi"
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <input/processors.dtsi>
#include <behaviors/input_gestures_accel.dtsi>
#include <mouse-gesture.dtsi>   /* kot149 モジュール */

// =========================================================================
// ★追加：加速度（アクセラレーション）のカーブ設定
// =========================================================================
&pointer_accel {
    input-type = <INPUT_EV_REL>;  // For relative input devices
    track-remainders;             // Accumulate fractional movements
    min-factor = <800>;          // 0.8x at very slow speeds
    max-factor = <2500>;         // 3.0x at fast speeds
    speed-threshold = <1500>;     // 1200 counts/sec for 1x
    speed-max = <6000>;          // 6000 counts/sec for max accel
    acceleration-exponent = <2>;  // Quadratic acceleration curve
};

&default_transform {
    col-offset = <6>;
};

&kscan0 {
        col-gpios
            = <&xiao_d 10 GPIO_ACTIVE_HIGH>
            , <&xiao_d 9 GPIO_ACTIVE_HIGH> 
            , <&xiao_d 8 GPIO_ACTIVE_HIGH> 
            , <&xiao_d 7 GPIO_ACTIVE_HIGH> 
            , <&gpio0 10 GPIO_ACTIVE_HIGH>
            ;
};


&pinctrl {
    spi0_default: spi0_default {    //通常時(SPI通信中)のピン構成
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>, //P0.05を指定(SCLK)
                <NRF_PSEL(SPIM_MOSI, 0, 4)>,    //P0.04を指定(SDIOだからMOSI,MISO両方の役割を担う)
                <NRF_PSEL(SPIM_MISO, 0, 4)>;
        };
    };

    spi0_sleep: spi0_sleep {    //スリープ時のピン構成(省電力)
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                <NRF_PSEL(SPIM_MISO, 0, 4)>;
            low-power-enable;
        };
    };
};


&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim"; //マイコンがnRFシリーズ
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;  //P0.09を指定(CS)

    trackball_central: trackball_central@0 {
        status = "okay";
        compatible = "pixart,pmw3610";  //トラボセンサ用のドライバとバインド
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&gpio0 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; //P0.02を指定(MOTION)
        cpi = <800>;
        //swap-xy;
        invert-x; //COROPIT版ではコメントアウトを外す
        //invert-y; //COROPIT版ではコメントアウトを外す
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
        force-awake; // ZMKがアクティブな間センサーを起きたままにする
    };
};

&zip_temp_layer {
    excluded-positions = <10 17 18 19 21 29 31>;
    require-prior-idle-ms = <300>;  // 好きなmsに調整（例: 300ms）
};

// Overrides for the input listener node
&trackball_central_listener {
    status = "okay";
    device = <&trackball_central>;

// ★変更：入力チェーンの先頭に &pointer_accel を追加
    input-processors = <
        &pointer_accel
        &zip_temp_layer 8 10000>;

    //input-processors = <&zip_temp_layer 8 10000>; //無効

// ★追加：レイヤー2のときだけカーソルを遅くする設定
    snipe_mode {
        layers = <4 5>;
        input-processors = 
            <&zip_temp_layer 8 10000>, // オートマウスの設定を引き継ぐ
            <&zip_xy_scaler 1 3>;       // カーソル移動量を1/3倍（3倍遅く）にする
    };

    scroller {
        layers = <9>;
        input-processors = 
            // <&zip_xy_transform INPUT_TRANSFORM_XY_SWAP>,        //X軸とY軸の入れ替え
            <&zip_xy_transform INPUT_TRANSFORM_X_INVERT>,       //X軸反転
            <&zip_xy_to_scroll_mapper>,                         //スクロールモードに変更
            <&zip_scroll_transform INPUT_TRANSFORM_X_INVERT>,   //スクロールのX軸反転
            <&zip_scroll_scaler 1 16>;                           //スクロール量を1/4倍
    };
// レイヤー10のときにY軸反転スクロール
    scroller_reverse {
        layers = <10>;
        input-processors = 
            <&zip_xy_transform INPUT_TRANSFORM_X_INVERT>,
            <&zip_xy_to_scroll_mapper>,
            <&zip_scroll_transform INPUT_TRANSFORM_X_INVERT>,
            <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>,
            <&zip_scroll_scaler 1 16>;
    };

    // レイヤー6: 仮想デスクトップ系＋タスクビュー＋普通の右矢印

    layer6_ctrl {
        layers = <11>;
        bindings =
            <&kp LG(LA(LC(RIGHT_ARROW)))>,
            // 右: Win + Alt + Ctrl + →,,,,,
            <&kp LG(LA(LC(LEFT_ARROW)))>,
            // 左: Win + Alt + Ctrl + ←,,,,,
            <&kp LG(TAB)>,
            // 上: Win + Tab,,,,,
            <&kp LG(M)>;

        // 下: → だけ

        tick = <200>;
        wait-ms = <40>;
        tap-ms = <5>;
    };

    // レイヤー5: ウィンドウスナップ系

    layer5_snap {
        layers = <12>;
        bindings =
            <&kp LG(RIGHT_ARROW)>,
            // 右にスナップ (Win + →),,,,,
            <&kp LG(LEFT_ARROW)>,
            // 左にスナップ (Win + ←),,,,,
            <&kp LG(UP_ARROW)>,
            // 最大化   (Win + ↑),,,,,
            <&kp LG(DOWN_ARROW)>;

        // 最小化 or 元のサイズ (Win + ↓)

        tick = <200>;
        wait-ms = <40>;
        tap-ms = <5>;
    };
// =========================================================================
// レイヤー11のときにジェスチャーを有効にする
// =========================================================================
    //mouse_gesture_mode {
        //layers = <11>;
        //input-processors = <&zip_mouse_gesture &zip_xy_scaler 0 1>;
    //};
// =========================================================================
};
